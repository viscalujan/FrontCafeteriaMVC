@model List<FrontCafeteriaMVC.Models.PedidoViewModel>

@{
    ViewData["Title"] = "Gestión de Pedidos";
}

<h2 class="mb-4">Pedidos en curso</h2>

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-dark">Todos (@Model.Count)</button>
    <button class="btn btn-outline-warning">Pendientes</button>
    <button class="btn btn-outline-info">En preparación</button>
    <button class="btn btn-outline-success">Listos</button>
</div>

<div class="row">
    @foreach (var p in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm p-3">
                <h5><i class="bi bi-person"></i> @p.Alumno</h5>
                <p class="text-muted">NC: @p.NumeroControl</p>
                <span class="badge
                        @(p.Estado == "Pendiente" ? "bg-warning" :
                                            p.Estado == "En preparación" ? "bg-info" :
                                            p.Estado == "Listo" ? "bg-success" :
                                            p.Estado == "Entregado" ? "bg-secondary" :
                                            "bg-danger")">@p.Estado</span>
            <hr />
            <ul class="list-group mb-2">
                @foreach (var d in p.Detalles)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            @d.Producto <span>x@d.Cantidad</span> <strong>$@d.Precio</strong>
                        </li>
                    }
                </ul>
                <p><strong>Total: </strong>$@p.TotalPedido</p>
                <div class="d-flex gap-2">
                    @if (p.Estado == "Pendiente")
                    {
                        <form asp-action="CambiarEstado" method="post">
                            <input type="hidden" name="idPedido" value="@p.IdPedidos" />
                            <input type="hidden" name="nuevoEstado" value="2" />
                            <button class="btn btn-primary w-100">Aceptar / Preparar</button>
                        </form>
                    }
                    else if (p.Estado == "En preparación")
                    {
                        <form asp-action="CambiarEstado" method="post">
                            <input type="hidden" name="idPedido" value="@p.IdPedidos" />
                            <input type="hidden" name="nuevoEstado" value="3" />
                            <button class="btn btn-success w-100">Marcar como Listo</button>
                        </form>
                    }
                    else if (p.Estado == "Listo")
                    {
                        <form asp-action="CambiarEstado" method="post">
                            <input type="hidden" name="idPedido" value="@p.IdPedidos" />
                            <input type="hidden" name="nuevoEstado" value="5" />
                            <button class="btn btn-secondary w-100">Entregado</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>
