@model List<FrontCafeteriaMVC.Models.PedidoViewModel>

@{
    ViewData["Title"] = "Gestión de Pedidos";
}

<h2 class="mb-4 text-center">Gestión de Pedidos</h2>

<table class="table table-striped table-bordered shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Alumno</th>
            <th>Estado</th>
            <th>Fecha</th>
            <th>Total</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var p in Model)
        {
            string badge = p.Estado switch
            {
                "Pendiente" => "bg-warning text-dark",
                "Preparando" => "bg-info text-dark",
                "Listo" => "bg-primary",
                "Rechazado" => "bg-danger",
                "Entregado" => "bg-success",
                _ => "bg-secondary"
            };

            <tr>
                <!-- ID -->
                <td>@p.IdPedidos</td>

                <!-- ALUMNO -->
                <td>
                    <b>@p.Alumno</b><br />
                    <small class="text-muted">@p.NumeroControl</small>
                </td>

                <!-- ESTADO -->
                <td>
                    <span class="badge @badge" style="font-size:14px;">
                        @p.Estado
                    </span>
                </td>

                <!-- FECHA -->
                <td>@p.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>

                <!-- TOTAL -->
                <td class="fw-bold text-success">
                    $@p.TotalPedido
                </td>

                <!-- ACCIONES -->
                <td>
                    <!-- VER DETALLES -->
                    <button class="btn btn-sm btn-secondary"
                            data-bs-toggle="modal"
                            data-bs-target="#detallesModal_@p.IdPedidos">
                        Ver detalles
                    </button>

                    <!-- CAMBIAR ESTADO -->
                    <form asp-action="CambiarEstado" method="post" class="d-inline">
                        <input type="hidden" name="idPedido" value="@p.IdPedidos" />

                        @if (p.Estado == "Pendiente")
                        {
                            <button name="nuevoEstado" value="2" class="btn btn-sm btn-info">Preparar</button>
                            <button name="nuevoEstado" value="4" class="btn btn-sm btn-danger">Rechazar</button>
                        }
                        else if (p.Estado == "Preparando")
                        {
                            <button name="nuevoEstado" value="3" class="btn btn-sm btn-primary">Listo</button>
                        }
                        else if (p.Estado == "Listo")
                        {
                            <button name="nuevoEstado" value="5" class="btn btn-sm btn-success">Entregar</button>
                        }
                    </form>
                </td>
            </tr>

            <!-- MODAL DETALLES -->
            <div class="modal fade" id="detallesModal_@p.IdPedidos" tabindex="-1">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content shadow">
                        <div class="modal-header">
                            <h5 class="modal-title">Detalles del Pedido #@p.IdPedidos</h5>
                            <button class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">
                            <p><b>Alumno:</b> @p.Alumno (@p.NumeroControl)</p>
                            <p><b>Total:</b> $@p.TotalPedido</p>

                            <table class="table table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Producto</th>
                                        <th>Cantidad</th>
                                        <th>Precio</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var d in p.Detalles)
                                    {
                                        <tr>
                                            <td>@d.Producto</td>
                                            <td>@d.Cantidad</td>
                                            <td>$@d.Precio</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="modal-footer">
                            <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </tbody>
</table>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
