@model List<FrontCafeteriaMVC.Models.PedidoViewModel>

@{
    ViewData["Title"] = "Gestión de Pedidos";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<style>

    /* 📌 Contenedor centrado y con ancho fijo */
    .contenedor-pedidos {
        max-width: 950px;
        margin: 0 auto;
    }

    /* 📌 Tarjeta compacta */
    .card-pedido {
        background: #fff;
        border-radius: 14px;
        padding: 20px;
        margin-bottom: 18px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
    }

    /* 📌 Badge con colores */
    .estado-badge {
        padding: 6px 12px;
        border-radius: 25px;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: capitalize;
    }

    .bg-pendiente {
        background: #fff3cd;
        color: #856404;
    }

    .bg-preparando {
        background: #cce5ff;
        color: #084298;
    }

    .bg-listo {
        background: #b8daff;
        color: #004085;
    }

    .bg-rechazado {
        background: #f8d7da;
        color: #721c24;
    }

    .bg-entregado {
        background: #d4edda;
        color: #155724;
    }

    /* 📌 Botones compactos */
    .btn-accion {
        width: 48%;
        font-size: 0.85rem;
    }

    .btn-group-acciones {
        display: flex;
        justify-content: space-between;
    }

</style>


<div class="container contenedor-pedidos mt-4">

    <h2 class="mb-4 text-center">Gestión de Pedidos</h2>

    @foreach (var p in Model)
    {
        string estado = p.Estado?.Trim().ToLower() ?? "";

        string badgeClass = estado.Contains("pend") ? "bg-pendiente" :
        estado.Contains("prepar") ? "bg-preparando" :
        estado.Contains("list") ? "bg-listo" :
        estado.Contains("entreg") ? "bg-entregado" :
        estado.Contains("rech") ? "bg-rechazado" :
        "bg-secondary text-white";

        <div class="card-pedido">

            <!-- ID + Alumno -->
            <div class="d-flex justify-content-between mb-1">
                <h5 class="fw-bold mb-0">#@p.IdPedidos - @p.Alumno</h5>
                <span class="estado-badge @badgeClass">@p.Estado</span>
            </div>

            <small class="text-muted">No. Control: @p.NumeroControl</small>

            <!-- Fecha + total -->
            <div class="mt-2">
                <small class="text-muted">@p.FechaPedido.ToString("dd/MM/yyyy HH:mm")</small>
                <div class="fw-bold text-success">$@p.TotalPedido</div>
            </div>

            <hr />

            <!-- Acciones -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <!-- Detalles -->
                <button class="btn btn-dark btn-sm w-100 me-2"
                        data-bs-toggle="modal"
                        data-bs-target="#modal_@p.IdPedidos">
                    Detalles
                </button>
            </div>

            <form asp-action="CambiarEstado" method="post">

                <input type="hidden" name="idPedido" value="@p.IdPedidos" />

                <div class="btn-group-acciones">

                    @* 🔥 Cambios de estado dinámicos *@
                    @if (estado.Contains("pend"))
                    {
                        <button name="nuevoEstado" value="2" class="btn btn-info btn-sm btn-accion">Preparar</button>
                        <button name="nuevoEstado" value="4" class="btn btn-danger btn-sm btn-accion">Rechazar</button>
                    }
                    else if (estado.Contains("prepar"))
                    {
                        <button name="nuevoEstado" value="3" class="btn btn-primary btn-sm btn-accion">Listo</button>
                        <button name="nuevoEstado" value="4" class="btn btn-outline-danger btn-sm btn-accion">Rechazar</button>
                    }
                    else if (estado.Contains("list"))
                    {
                        <button name="nuevoEstado" value="5" class="btn btn-success btn-sm w-100">Entregar</button>
                    }
                    else
                    {
                        <span class="text-muted">No hay acciones disponibles</span>
                    }

                </div>

            </form>

        </div>

        <!-- MODAL DETALLES -->
        <div class="modal fade" id="modal_@p.IdPedidos" tabindex="-1">
            <div class="modal-dialog modal-md">
                <div class="modal-content">

                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title">Pedido #@p.IdPedidos</h5>
                        <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">

                        <p><strong>Alumno:</strong> @p.Alumno</p>
                        <p><strong>No. Control:</strong> @p.NumeroControl</p>
                        <p><strong>Total:</strong> $@p.TotalPedido</p>
                        <p><strong>Fecha:</strong> @p.FechaPedido.ToString("dd/MM/yyyy HH:mm")</p>
                        <hr />

                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Cant.</th>
                                    <th>Precio</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in p.Detalles)
                                {
                                    <tr>
                                        <td>@d.Producto</td>
                                        <td>@d.Cantidad</td>
                                        <td>$@d.Precio</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>

                </div>
            </div>
        </div>

    }

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
