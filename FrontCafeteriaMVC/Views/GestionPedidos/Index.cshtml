@model List<FrontCafeteriaMVC.Models.PedidoViewModel>

@{
    ViewData["Title"] = "Gestión de Pedidos";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<style>
    .tabla-pedidos {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .estado-badge {
        font-size: 14px;
        padding: 6px 14px;
        border-radius: 30px;
    }
</style>

<div class="container mt-4">

    <div class="text-center mb-4">
        <h2 class="fw-bold">Gestión de Pedidos</h2>
        <p class="text-muted">Administra los pedidos de manera rápida y clara</p>
    </div>

    <div class="tabla-pedidos">

        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Alumno</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var p in Model)
                {
                    string estado = p.Estado?.Trim().ToLower() ?? "";

                    string badge = estado switch
                    {
                        string s when s.Contains("pend") => "bg-warning text-dark",
                        string s when s.Contains("prepar") => "bg-info text-dark",
                        string s when s.Contains("list") => "bg-primary",
                        string s when s.Contains("rech") => "bg-danger",
                        string s when s.Contains("entreg") => "bg-success",
                        _ => "bg-secondary"
                    };

                    <tr>
                        <td class="fw-bold">@p.IdPedidos</td>

                        <td>
                            <strong>@p.Alumno</strong><br />
                            <small class="text-muted">@p.NumeroControl</small>
                        </td>

                        <td>
                            <span class="estado-badge badge @badge">@p.Estado</span>
                        </td>

                        <td>@p.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>

                        <td class="fw-bold text-success">
                            $@p.TotalPedido
                        </td>

                        <td class="text-center">

                            <!-- Detalles -->
                            <button class="btn btn-sm btn-secondary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modal_@p.IdPedidos">
                                Detalles
                            </button>

                            <br />

                            <!-- Cambiar estado -->
                            <form asp-action="CambiarEstado" method="post" class="mt-2">

                                <input type="hidden" name="idPedido" value="@p.IdPedidos" />

                                @* === BOTONES DINÁMICOS SIN IMPORTAR EL TEXTO EXACTO DEL BACKEND === *@

                                @if (estado.Contains("pend"))  @* Pendiente *@
                                {
                                    <button name="nuevoEstado" value="2" class="btn btn-sm btn-info w-100 mb-1">Preparar</button>
                                    <button name="nuevoEstado" value="4" class="btn btn-sm btn-danger w-100">Rechazar</button>
                                }
                                else if (estado.Contains("prepar"))
     @* Preparando *@
                                {
                                    <button name="nuevoEstado" value="3" class="btn btn-sm btn-primary w-100 mb-1">Listo</button>
                                    <button name="nuevoEstado" value="4" class="btn btn-sm btn-outline-danger w-100">Rechazar</button>
                                }
                                else if (estado.Contains("list"))
     @* Listo *@
                                {
                                    <button name="nuevoEstado" value="5" class="btn btn-sm btn-success w-100">Entregar</button>
                                }
                                else
                                {
                                    <span class="text-muted">Sin acciones</span>
                                }
                            </form>

                        </td>
                    </tr>


                    <!-- MODAL DETALLES -->
                    <div class="modal fade" id="modal_@p.IdPedidos" tabindex="-1">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">

                                <div class="modal-header bg-dark text-white">
                                    <h5 class="modal-title">
                                        Pedido #@p.IdPedidos
                                    </h5>
                                    <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>

                                <div class="modal-body">
                                    <p>
                                        <strong>Alumno:</strong> @p.Alumno <br />
                                        <strong>Control:</strong> @p.NumeroControl <br />
                                        <strong>Total:</strong> $@p.TotalPedido <br />
                                        <strong>Fecha:</strong> @p.FechaPedido.ToString("dd/MM/yyyy HH:mm") <br />
                                        <strong>Estado:</strong> @p.Estado
                                    </p>

                                    <table class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <th>Producto</th>
                                                <th>Cantidad</th>
                                                <th>Precio</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var d in p.Detalles)
                                            {
                                                <tr>
                                                    <td>@d.Producto</td>
                                                    <td>@d.Cantidad</td>
                                                    <td>$@d.Precio</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="modal-footer">
                                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                                </div>

                            </div>
                        </div>
                    </div>

                }
            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
