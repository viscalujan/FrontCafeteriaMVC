@model List<FrontCafeteriaMVC.Models.Producto>

@{
    ViewData["Title"] = "Menú de productos";
}

<!-- 🔥 UsuarioId enviado desde el controlador -->
<input type="hidden" id="usuarioId" value="@ViewBag.UsuarioId" />

<h2 class="mb-4">Menú disponible</h2>

<!-- BOTÓN MIS PEDIDOS -->
<button class="btn btn-primary mb-3" data-bs-toggle="offcanvas" data-bs-target="#offcanvasPedidos">
    📦 Mis pedidos
</button>

<div class="row">

    <!-- LISTA DE PRODUCTOS -->
    <div class="col-md-8">
        <div class="row">
            @foreach (var p in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100">

                        <!-- IMAGEN -->
                        <img src="~/img/productos/@(p.Nombre.Replace(" ", "").ToLower()).jpg"
                             class="card-img-top"
                             style="height:180px; object-fit:cover;" />

                        <div class="card-body">
                            <h5 class="card-title">@p.Nombre</h5>
                            <p class="text-muted mb-1">$@p.Precio</p>
                            <span class="badge bg-dark">Stock: @p.Cantidad</span>

                            <!-- CANTIDAD -->
                            <div class="input-group mt-2">
                                <button class="btn btn-outline-secondary btn-sm"
                                        onclick="changeQty(@p.Id, -1)">
                                    -
                                </button>

                                <input id="qty-@p.Id"
                                       type="text"
                                       class="form-control text-center"
                                       value="1"
                                       readonly />

                                <button class="btn btn-outline-secondary btn-sm"
                                        onclick="changeQty(@p.Id, 1)">
                                    +
                                </button>
                            </div>

                            <!-- BOTÓN AÑADIR -->
                            <button class="btn btn-dark w-100 mt-2"
                                    onclick="addToCart(@p.Id, '@p.Nombre', @p.Precio)">
                                🛒 Agregar
                            </button>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>

    <!-- CARRITO -->
    <div class="col-md-4">
        <div class="card p-3 shadow-sm">
            <h4>Tu pedido</h4>

            <ul id="cart-list" class="list-group mb-3"></ul>

            <h5>Total: $<span id="total">0</span></h5>

            <button class="btn btn-success w-100 mt-2" onclick="submitOrder()">
                Realizar pedido
            </button>
        </div>
    </div>
</div>

<!-- 🟦 OFFCANVAS: MIS PEDIDOS -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasPedidos">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">Mis pedidos</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body">
        <div id="lista-mis-pedidos" class="list-group">
            <p class="text-center text-muted">Cargando...</p>
        </div>
    </div>
</div>

<!-- 🔍 MODAL DETALLES DE PEDIDO -->
<div class="modal fade" id="modalDetallesPedido" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">

            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Detalles del pedido</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="modalDetallesBody">
                Cargando...
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let cart = [];

        /* ============================
           CAMBIAR CANTIDAD
        ============================ */
        function changeQty(id, delta) {
            const input = document.getElementById(`qty-${id}`);
            let value = parseInt(input.value) + delta;
            input.value = value < 1 ? 1 : value;
        }

        /* ============================
           AGREGAR AL CARRITO
        ============================ */
        function addToCart(id, name, price) {
            const qty = parseInt(document.getElementById(`qty-${id}`).value);

            const existing = cart.find(x => x.id === id);

            if (existing) {
                existing.qty += qty;
            } else {
                cart.push({ id, name, price, qty });
            }

            renderCart();

            Swal.fire({
                icon: "success",
                title: "Producto agregado",
                text: `${name} x${qty}`,
                timer: 1200,
                showConfirmButton: false
            });
        }

        /* ============================
           RENDER CARRITO
        ============================ */
        function renderCart() {
            const list = document.getElementById("cart-list");
            list.innerHTML = "";

            let total = 0;

            cart.forEach(c => {
                const li = document.createElement("li");
                li.classList.add("list-group-item", "d-flex", "justify-content-between");

                li.innerHTML = `${c.name} x${c.qty}
                    <strong>$${(c.price * c.qty).toFixed(2)}</strong>`;

                list.appendChild(li);

                total += c.price * c.qty;
            });

            document.getElementById("total").innerText = total.toFixed(2);
        }

        /* ============================
           ENVIAR PEDIDO
        ============================ */
        async function submitOrder() {
            if (cart.length === 0) {
                Swal.fire("Carrito vacío", "Agrega productos primero.", "warning");
                return;
            }

            const usuarioId = parseInt(document.getElementById("usuarioId").value);

            if (!usuarioId || usuarioId <= 0) {
                Swal.fire("Error", "No se pudo obtener el usuario. Inicia sesión otra vez.", "error");
                return;
            }

            const detalles = cart.map(c => ({
                productoId: c.id,
                cantidad: c.qty
            }));

            const pedido = {
                usuarioId: usuarioId,
                detalles: detalles
            };

            const confirm = await Swal.fire({
                title: "¿Confirmar pedido?",
                html: `<strong>Total: $${document.getElementById("total").innerText}</strong>`,
                icon: "question",
                showCancelButton: true,
                confirmButtonText: "Sí, enviar",
                cancelButtonText: "Cancelar"
            });

            if (!confirm.isConfirmed) return;

            Swal.fire({
                title: "Procesando...",
                text: "Creando tu pedido...",
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            const res = await fetch("/Pedidos/RealizarPedido", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(pedido)
            });

            const data = await res.json();

            if (!res.ok) {
                Swal.fire("Error", data.error ?? "Error desconocido", "error");
                return;
            }

            Swal.fire({
                icon: "success",
                title: "Pedido realizado",
                timer: 2000,
                showConfirmButton: false
            });

            cart = [];
            renderCart();
        }


        /* ============================
           CARGAR MIS PEDIDOS (FILTRADO POR NC)
        ============================ */
        async function cargarPedidosUsuario() {

            const contenedor = document.getElementById("lista-mis-pedidos");
            contenedor.innerHTML = `<p class='text-muted text-center'>Cargando...</p>`;

            const res = await fetch("/Pedidos/MisPedidos");

            if (!res.ok) {
                contenedor.innerHTML = `<p class='text-danger text-center'>Error al cargar.</p>`;
                return;
            }

            const pedidos = await res.json();

            if (!Array.isArray(pedidos) || pedidos.length === 0) {
                contenedor.innerHTML = `<p class='text-center text-muted'>No tienes pedidos aún.</p>`;
                return;
            }

            let html = "";

            pedidos.forEach(p => {

                const badgeClass =
                    p.estado.includes("Pend") ? "badge bg-warning text-dark" :
                    p.estado.includes("Prep") ? "badge bg-info text-dark" :
                    p.estado.includes("Listo") ? "badge bg-primary" :
                    p.estado.includes("Entre") ? "badge bg-success" :
                    p.estado.includes("Rech") ? "badge bg-danger" :
                    "badge bg-secondary";

                html += `
                    <div class="list-group-item mb-2">

                        <div class="d-flex justify-content-between">
                            <strong>Pedido #${p.idPedidos}</strong>
                            <span class="${badgeClass}">${p.estado}</span>
                        </div>

                        <small class="text-muted">${new Date(p.fechaPedido).toLocaleString()}</small>

                        <div class="fw-bold mt-1">$${p.totalPedido}</div>

                        <button class="btn btn-outline-dark btn-sm w-100 mt-2"
                                onclick="verDetallesPedido(${p.idPedidos})">
                            Ver detalles
                        </button>

                    </div>
                `;
            });

            contenedor.innerHTML = html;
        }

        /* Evento cuando se abre el offcanvas */
        document.getElementById("offcanvasPedidos")
            .addEventListener("shown.bs.offcanvas", cargarPedidosUsuario);


        /* ============================
           MODAL DETALLES (FILTRADO)
        ============================ */
        async function verDetallesPedido(idPedido) {

            const res = await fetch("/Pedidos/MisPedidos");
            const pedidos = await res.json();

        const pedido = pedidos.find(p =>
            p.idPedidos == idPedido ||
            p.idPedido == idPedido ||
            p.id == idPedido ||
            p.Id == idPedido
        );
            const body = document.getElementById("modalDetallesBody");

                  if (!pedido) {
            console.warn("Los datos de pedidos:", pedidos);
            body.innerHTML = "<p class='text-danger'>No se encontró el pedido (ID no coincide con el JSON).</p>";
            return;
        }

            let html = `
                <p><strong>Estado:</strong> ${pedido.estado}</p>
                <p><strong>Fecha:</strong> ${new Date(pedido.fechaPedido).toLocaleString()}</p>
                <p><strong>Total:</strong> $${pedido.totalPedido}</p>

                <hr>
                <h6>Productos:</h6>

                <ul class="list-group">
            `;

            pedido.detalles.forEach(d => {
                html += `
                    <li class="list-group-item d-flex justify-content-between">
                        ${d.producto} x${d.cantidad}
                        <strong>$${d.precio}</strong>
                    </li>
                `;
            });

            html += "</ul>";

            body.innerHTML = html;

            new bootstrap.Modal(document.getElementById('modalDetallesPedido')).show();
        }

    </script>
}
