@model FrontCafeteriaMVC.Models.ReporteVentasViewModel

@{
    ViewData["Title"] = "Reporte de Ventas Agrupadas";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <!-- FILTROS -->
    <form asp-action="Reporte" method="get" class="mb-4 card card-body">
        <div class="row g-3">

            <div class="col-md-3">
                <label class="form-label">Fecha inicio:</label>
                <input type="date" name="desde" class="form-control"
                       value="@Model.Desde?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Fecha fin:</label>
                <input type="date" name="hasta" class="form-control"
                       value="@Model.Hasta?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel"></i> Filtrar
                </button>
            </div>

        </div>

        <a asp-action="GenerarExcel"
           asp-route-desde="@Model.Desde?.ToString("yyyy-MM-dd")"
           asp-route-hasta="@Model.Hasta?.ToString("yyyy-MM-dd")"
           class="btn btn-success mt-3">
            <i class="bi bi-file-excel"></i> Exportar a Excel
        </a>

    </form>



    <!-- RESUMEN -->
    <div class="alert alert-info mb-4">
        <strong>Periodo:</strong> @Model.Desde?.ToString("d") al @Model.Hasta?.ToString("d") |
        <strong>Total General:</strong> @Model.TotalGeneral.ToString("C")
    </div>



    <!-- LISTADO DE VENTAS AGRUPADAS -->
    @if (Model.VentasAgrupadas.Any())
    {
        @foreach (var venta in Model.VentasAgrupadas)
        {
            <div class="card mb-3 border-@(
                 venta.MetodoPago == "cancelado" ? "danger" :
                 venta.MetodoPago == "efectivo" ? "success" :
                 venta.MetodoPago == "pedido" ? "warning" : "info"
                        )">

        <!-- HEADER DEL TICKET -->
        <div class="card-header bg-light d-flex justify-content-between align-items-center">

            <div>
                <strong>Ticket #@venta.VentaId</strong> -
                @venta.Fecha.ToString("g") -

                <span class="badge
                            @(venta.MetodoPago == "cancelado" ? "bg-danger" :
                                                    venta.MetodoPago == "efectivo" ? "bg-success" :
                                                    venta.MetodoPago == "pedido" ? "bg-warning text-dark" : "bg-info")">
                    @venta.MetodoPago
                </span>
            </div>

                    <div class="d-flex align-items-center gap-2">
                        <strong>Total:</strong>
                        <span>@venta.TotalVenta.ToString("C")</span>

                        @* Botón cancelar solo si NO está cancelada *@
                @if (venta.MetodoPago != "cancelado")
                        {
                            <button class="btn btn-danger btn-sm"
                                    onclick="abrirModalCancelarVenta(@venta.VentaId)">
                                Cancelar
                            </button>
                        }
                        else
                        {
                            <span class="badge bg-danger">Cancelada</span>
                        }
                    </div>

                </div>



                <!-- DETALLES DEL TICKET -->
                <div class="card-body">

                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>P. Unitario</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detalle in venta.Detalles)
                            {
                                <tr>
                                    <td>@detalle.ProductoNombre</td>
                                    <td>@detalle.Cantidad</td>
                                    <td>@detalle.PrecioUnitario.ToString("C")</td>
                                    <td>@detalle.Total.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>

            </div>
        }
    }
    else
    {
        <div class="alert alert-warning text-center">
            No se encontraron ventas en el periodo seleccionado.
        </div>
    }
</div>



<!-- ========================= -->
<!--   MODAL PARA CANCELAR      -->
<!-- ========================= -->

<div class="modal fade" id="modalCancelarVenta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <form method="post" asp-action="CancelarVenta">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Cancelar venta</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <p>¿Seguro que deseas cancelar esta venta?</p>
                    <p class="text-danger">Esta acción revertirá inventario y crédito (si aplica).</p>

                    <input type="hidden" id="ventaIdInput" name="idVenta" />
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">Sí, cancelar</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </form>

        </div>
    </div>
</div>


<!-- SCRIPT -->
<script>
    function abrirModalCancelarVenta(idVenta) {
        document.getElementById("ventaIdInput").value = idVenta;

        var modal = new bootstrap.Modal(document.getElementById('modalCancelarVenta'));
        modal.show();
    }
</script>
