@model FrontCafeteriaMVC.Models.HistorialCreditoFiltroViewModel

@{
    ViewData["Title"] = "Historial de Crédito";
}

<div class="container">
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <!-- 🔹 Formulario de filtrado -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" asp-action="HistorialCredito" class="mb-0">

                <div class="row g-3">

                    <!-- Fecha inicio -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Desde</label>
                        <input type="date"
                               name="desde"
                               class="form-control"
                               value="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <!-- Fecha fin -->
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Hasta</label>
                        <input type="date"
                               name="hasta"
                               class="form-control"
                               value="@(Model.FechaFin?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <!-- Número de control -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Número de Control</label>
                        <input type="text"
                               name="numeroControl"
                               class="form-control"
                               value="@Model.NumeroControl"
                               placeholder="Ingrese número de control" />
                    </div>

                    <!-- Botones -->
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-filter"></i> Filtrar
                        </button>

                        @if (!string.IsNullOrWhiteSpace(Model.NumeroControl) ||
                             Model.FechaInicio.HasValue ||
                             Model.FechaFin.HasValue)
                        {
                            <a href="@Url.Action("HistorialCredito")"
                               class="btn btn-outline-secondary ms-2">
                                <i class="fas fa-times"></i>
                            </a>
                        }
                    </div>
                </div>

            </form>
        </div>
    </div>

    <!-- 🔹 Resumen de filtro aplicado -->
    <div class="mb-3">
        <div class="alert alert-info">
            @if (!string.IsNullOrWhiteSpace(Model.NumeroControl))
            {
                <span>Filtrado por número de control: <strong>@Model.NumeroControl</strong></span><br />
            }

            <span>Rango de fechas:
                <strong>@(Model.FechaInicio?.ToString("dd/MM/yyyy"))</strong>
                hasta
                <strong>@(Model.FechaFin?.ToString("dd/MM/yyyy"))</strong>
            </span>
        </div>
    </div>

    <!-- 🔹 Tabla -->
    @if (Model.Historial != null && Model.Historial.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Número Control</th>
                        <th>Cantidad</th>
                        <th>Fecha</th>
                        <th>Autorizado Por</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Historial)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.NumeroControlAfectado</td>
                            <td class="@(item.Cantidad < 0 ? "text-danger fw-bold" : "text-success fw-bold")">
                                @item.Cantidad.ToString("C")
                            </td>
                            <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.AutCorreo</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-muted mt-2">
            <strong>Total:</strong> @Model.Historial.Count registros.
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="fas fa-info-circle"></i>
            No hay registros coincidentes con los filtros seleccionados.
        </div>
    }

    <!-- 🔹 Botones -->
    <div class="mt-4">

        <a href="@Url.Action("PagarLiquidacion", "Usuarios")"
           class="btn btn-warning">
            <i class="fas fa-money-bill-wave"></i> Pagar Liquidación
        </a>

        <a href="@Url.Action("ExportarHistorial",
                 new {
                     numeroControl = Model.NumeroControl,
                     desde = Model.FechaInicio?.ToString("yyyy-MM-dd"),
                     hasta = Model.FechaFin?.ToString("yyyy-MM-dd")
                 })"
           class="btn btn-success ms-2">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </a>

    </div>
</div>

<style>
    .table th {
        white-space: nowrap;
    }
</style>
