@model FrontCafeteriaMVC.Models.MiCuentaVM
@{
    ViewData["Title"] = "Mi Cuenta";
}

<h2 class="text-center mb-4">Mi Cuenta</h2>

<div class="card shadow-sm p-4 mb-4">
    <h4>Bienvenido, @Model.Nombre (@Model.NumeroControl)</h4>
    <h5>Crédito Disponible:</h5>
    <p class="fs-5 fw-bold text-success">@Model.Credito.ToString("C")</p>
</div>
<div class="d-flex justify-content-center mt-4">
    <a asp-controller="Pedidos" asp-action="Index"
       class="btn btn-dark px-4 py-2"
       style="font-size:1.1rem; border-radius:10px;">
        🛒 Ir al menú de pedidos
    </a>
</div>


<div class="card shadow-sm p-4 mb-4">
    <h4>Mi Código QR</h4>

    @if (!string.IsNullOrEmpty(Model.QrBase64))
    {
        <div class="text-center">
            <img id="qrImage"
                 src="@Model.QrBase64"
                 class="img-thumbnail"
                 style="max-width: 200px;" />
            <br />

            <a id="downloadQrBtn"
               class="btn btn-primary mt-2"
               href="@Model.QrDownloadUrl"
               download="codigo_qr.png">
                Descargar QR
            </a>

            <button id="btnActualizarQR"
                    class="btn btn-warning mt-2"
                    onclick="actualizarQR()">
                <span id="spinnerQR" class="spinner-border spinner-border-sm me-2 d-none"></span>
                Actualizar QR
            </button>
        </div>
    }
    else
    {
        <p>No hay código QR disponible.</p>
    }
</div>

@section Scripts {
    <script>
        function actualizarQR() {

            const numeroControl = "@Model.NumeroControl";
            const btn = document.getElementById("btnActualizarQR");
            const spinner = document.getElementById("spinnerQR");
            const qrImage = document.getElementById("qrImage");
            const downloadBtn = document.getElementById("downloadQrBtn");

            // --- ACTIVAR SPINNER ---
            spinner.classList.remove("d-none");
            btn.disabled = true;
            btn.innerText = " Actualizando...";

            fetch(`/Usuarios/ActualizarQR?numeroControl=${numeroControl}`, {
                method: "POST",
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
            .then(r => r.json())
            .then(data => {

                if (data.success) {

                    // Pequeño efecto visual
                    qrImage.style.opacity = "0.4";

                    setTimeout(() => {
                        // Actualizar imagen
                        qrImage.src = "data:image/png;base64," + data.qrBase64;
                        qrImage.style.opacity = "1";
                    }, 300);

                    // Actualizar URL del botón "Descargar"
                    downloadBtn.href = data.downloadUrl;

                } else {
                    alert("Error: " + data.message);
                }

            })
            .catch(err => {
                alert("Error al actualizar QR: " + err);
            })
            .finally(() => {
                // --- DESACTIVAR SPINNER ---
                spinner.classList.add("d-none");
                btn.disabled = false;
                btn.innerHTML = `
                    <span id="spinnerQR" class="spinner-border spinner-border-sm me-2 d-none"></span>
                    Actualizar QR
                `;
            });
        }
    </script>

}


<div class="card shadow-sm p-4">
    <h4>Historial de Crédito</h4>
    @if (Model.Historial != null && Model.Historial.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Cantidad</th>
                    <th>Para o desde</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Historial)
                {
                    <tr>
                        <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Cantidad.ToString("C")</td>
                        <td>@item.AutCorreo</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No hay registros de crédito.</p>
    }
</div>

<!-- 🔹 BOTÓN A TRANSFERENCIAS (ÚNICO CAMBIO) -->
<div class="text-center mt-4">
    <a asp-controller="Transferencias" asp-action="Index" class="btn btn-dark btn-lg px-4">
        <i class="fa-solid fa-arrow-right-arrow-left me-2"></i> Transferir Saldo
    </a>
</div>
