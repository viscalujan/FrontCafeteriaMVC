@{
    ViewData["Title"] = "Verificar Código";
}

<div class="d-flex justify-content-center mt-5">
    <div class="card p-4 shadow" style="width: 450px; border-radius: 20px;">

        <h4 class="fw-bold">Verificar Código</h4>
        <p class="text-muted">
            Ingresa el código de 6 dígitos enviado a
            <strong>@ViewBag.Correo</strong>
        </p>

        <form method="post" id="form-codigo">
            <input type="hidden" name="correo" value="@ViewBag.Correo" />
            <input type="hidden" name="codigo" id="codigoFull" />

            <div class="d-flex justify-content-between mb-3">
                @for (int i = 0; i < 6; i++)
                {
                    <input maxlength="1"
                           class="form-control text-center code-input"
                           style="width: 45px; height: 55px; font-size: 22px;" />
                }
            </div>

            <p class="text-muted text-center mb-3">Ingresa el código que recibiste por correo</p>

            <button id="btn-verificar" class="btn btn-dark w-100" type="submit">
                <span class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
                <span class="btn-text">Verificar código →</span>
            </button>

            <a href="/Recuperar" class="btn btn-light w-100 mt-3">← Volver</a>

            <p class="text-center text-muted mt-3">
                ¿No recibiste el código?
                <a href="/Recuperar">Reenviar</a>
            </p>
        </form>
    </div>
</div>

@* TOAST *@
@if (TempData["ToastMessage"] != null)
{
    <div id="toast-notify"
         data-type="@TempData["ToastType"]"
         data-message="@TempData["ToastMessage"]">
    </div>
}

<style>
    .toast-container-custom {
        position: fixed;
        right: 20px;
        bottom: 20px;
        z-index: 9999;
        min-width: 260px;
        max-width: 340px;
    }

    .toast-card {
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.18);
        padding: 14px 18px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: 14px;
    }

    .toast-icon {
        font-size: 18px;
        margin-top: 2px;
    }

    .toast-title {
        font-weight: 600;
    }

    .toast-text {
        color: #6b7280;
        font-size: 13px;
    }

    .toast-success .toast-icon {
        color: #16a34a;
    }

    .toast-error .toast-icon {
        color: #dc2626;
    }

    .toast-warning .toast-icon {
        color: #d97706;
    }
</style>

<script>
    // Manejo inputs de código
    const inputs = document.querySelectorAll(".code-input");
    const hidden = document.getElementById("codigoFull");

    inputs.forEach((input, idx) => {
        input.addEventListener("input", (e) => {
            const value = e.target.value.replace(/[^0-9]/g, "");
            e.target.value = value;

            if (value && idx < inputs.length - 1) {
                inputs[idx + 1].focus();
            }
        });

        input.addEventListener("keydown", (e) => {
            if (e.key === "Backspace" && !e.target.value && idx > 0) {
                inputs[idx - 1].focus();
            }
        });
    });

    document.getElementById("form-codigo")?.addEventListener("submit", function (e) {
        let code = "";
        inputs.forEach(i => code += (i.value || ""));

        hidden.value = code;

        const btn = document.getElementById("btn-verificar");
        const spinner = btn.querySelector(".spinner-border");
        const text = btn.querySelector(".btn-text");

        btn.disabled = true;
        spinner.classList.remove("d-none");
        text.textContent = "Verificando...";
    });

    // Toast
    document.addEventListener("DOMContentLoaded", () => {
        const data = document.getElementById("toast-notify");
        if (!data) return;

        const type = data.dataset.type || "success";
        const msg = data.dataset.message || "";

        const container = document.createElement("div");
        container.className = "toast-container-custom";

        const card = document.createElement("div");
        card.className = "toast-card";

        if (type === "success") card.classList.add("toast-success");
        else if (type === "error") card.classList.add("toast-error");
        else if (type === "warning") card.classList.add("toast-warning");

        const icon = document.createElement("div");
        icon.className = "toast-icon";
        icon.textContent = type === "success" ? "✔" : type === "error" ? "✖" : "⚠";

        const body = document.createElement("div");
        const title = document.createElement("div");
        title.className = "toast-title";
        title.textContent = type === "success" ? "Éxito" : type === "error" ? "Error" : "Aviso";

        const text = document.createElement("div");
        text.className = "toast-text";
        text.textContent = msg;

        body.appendChild(title);
        body.appendChild(text);
        card.appendChild(icon);
        card.appendChild(body);
        container.appendChild(card);
        document.body.appendChild(container);

        setTimeout(() => {
            container.style.opacity = "0";
            container.style.transition = "opacity 0.4s ease";
            setTimeout(() => container.remove(), 400);
        }, 3500);
    });
</script>
