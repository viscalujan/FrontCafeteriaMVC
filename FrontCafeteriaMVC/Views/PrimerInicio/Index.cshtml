@{
    ViewData["Title"] = "Primer Inicio de Sesión";
}

<div class="d-flex justify-content-center mt-5">
    <div class="card p-4 shadow" style="width: 420px; border-radius: 20px;">
        <h3 class="fw-bold text-center">Primer Inicio de Sesión</h3>

        <p class="text-muted text-center mb-3">
            Esta es tu primera vez iniciando sesión.<br />
            Por seguridad, debes cambiar la contraseña temporal que te fue asignada.
        </p>

        <form method="post" id="form-primerinicio">
            <label class="fw-semibold">Correo electrónico</label>
            <input type="email" name="correo" class="form-control mb-2" placeholder="tu@correo.com" required />

            <small class="text-muted">Se enviará un código de verificación a tu correo.</small>

            <button id="btn-enviar" class="btn btn-dark w-100 mt-3" type="submit">
                <span class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
                <span class="btn-text">Continuar →</span>
            </button>
        </form>
    </div>
</div>

@if (TempData["ToastMessage"] != null)
{
    <div id="toast-notify"
         data-type="@TempData["ToastType"]"
         data-message="@TempData["ToastMessage"]">
    </div>
}

<style>
    .toast-container-custom {
        position: fixed;
        right: 20px;
        bottom: 20px;
        z-index: 9999;
        min-width: 260px;
        max-width: 340px;
    }

    .toast-card {
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.18);
        padding: 14px 18px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: 14px;
    }

    .toast-icon {
        font-size: 18px;
        margin-top: 2px;
    }

    .toast-title {
        font-weight: 600;
    }

    .toast-text {
        color: #6b7280;
        font-size: 13px;
    }

    .toast-success .toast-icon {
        color: #16a34a;
    }

    .toast-error .toast-icon {
        color: #dc2626;
    }

    .toast-warning .toast-icon {
        color: #d97706;
    }
</style>

<script>
    document.getElementById("form-primerinicio")?.addEventListener("submit", function () {
        const btn = document.getElementById("btn-enviar");
        const spinner = btn.querySelector(".spinner-border");
        const text = btn.querySelector(".btn-text");

        btn.disabled = true;
        spinner.classList.remove("d-none");
        text.textContent = "Enviando...";
    });

    document.addEventListener("DOMContentLoaded", () => {
        const data = document.getElementById("toast-notify");
        if (!data) return;

        const type = data.dataset.type || "success";
        const msg = data.dataset.message || "";

        const container = document.createElement("div");
        container.className = "toast-container-custom";

        const card = document.createElement("div");
        card.className = "toast-card";

        if (type === "success") card.classList.add("toast-success");
        else if (type === "error") card.classList.add("toast-error");
        else if (type === "warning") card.classList.add("toast-warning");

        const icon = document.createElement("div");
        icon.className = "toast-icon";
        icon.textContent = type === "success" ? "✔" : type === "error" ? "✖" : "⚠";

        const body = document.createElement("div");
        const title = document.createElement("div");
        title.className = "toast-title";
        title.textContent = type === "success" ? "Éxito" : type === "error" ? "Error" : "Aviso";

        const text = document.createElement("div");
        text.className = "toast-text";
        text.textContent = msg;

        body.appendChild(title);
        body.appendChild(text);
        card.appendChild(icon);
        card.appendChild(body);
        container.appendChild(card);
        document.body.appendChild(container);

        setTimeout(() => {
            container.style.opacity = "0";
            container.style.transition = "opacity 0.4s ease";
            setTimeout(() => container.remove(), 400);
        }, 3500);
    });
</script>
